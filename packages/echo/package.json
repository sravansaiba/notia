{
  "name": "notia",
  "version": "0.1.1",
  "description": "Expressive, accessible toast notifications for React and Next.js.",
  "license": "MIT",
  "author": "Sravan Saiba",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node ../../scripts/copy-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "node ../../scripts/release-gate.mjs"
  },
  "keywords": [
    "react",
    "toast",
    "notification",
    "nextjs",
    "accessible",
    "typescript"
  ]
}
