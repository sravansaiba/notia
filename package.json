{
  "name": "notia-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "^22.14.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @notia/docs dev",
    "build": "pnpm --filter notia build && pnpm --filter @notia/docs build",
    "build:lib": "pnpm --filter notia build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck": "pnpm --filter notia typecheck && pnpm --filter @notia/docs typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs",
    "test:compat": "node scripts/check-compat.mjs",
    "audit:deps": "pnpm audit --audit-level=high",
    "check:release-tools": "node scripts/check-release-tools.mjs",
    "verify": "pnpm audit:deps && pnpm build && pnpm test:coverage && pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:release-tools && pnpm check:package && pnpm test:compat && pnpm test:e2e",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
